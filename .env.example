# Copia este archivo a .env y completa los valores reales. Nunca subas .env al repo.

# --- Acceso a la app (HTTP Basic Auth) ---
# Credenciales de la cuenta compartida de RRHH que protegen TODA la aplicación.
# La app no arranca si faltan. Cambia estos valores por unos propios.
APP_USERNAME=rrhh
APP_PASSWORD=cambia-esta-contrasena

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# --- Google Drive (OAuth 2.0) ---
# 1. En Google Cloud Console → APIs & Services → Credentials → Create Credentials
#    → OAuth 2.0 Client ID → Desktop App → Download JSON → guárdalo como credentials.json
# 2. Ejecuta una sola vez: python setup_google_auth.py
#    Esto abrirá el navegador, pedirá autorización y guardará token.json automáticamente.
GOOGLE_OAUTH_CREDENTIALS_PATH=C:\credentials\credentials.json
GOOGLE_OAUTH_TOKEN_PATH=C:\credentials\token.json

# --- Alternativa por variable de entorno (despliegue en servidor) ---
# Para servidores SIN sistema de archivos persistente (contenedores efímeros,
# PaaS, etc.) puedes pasar el contenido completo de los JSON directamente en
# estas variables, en lugar de rutas a archivos. Pega el JSON en UNA sola línea.
# Basta con UNA de las dos formas por cada credencial: o el _PATH (archivo) o
# el _JSON (variable), NO ambas. Si defines la variable _JSON, tiene prioridad
# sobre el _PATH correspondiente.
# GOOGLE_OAUTH_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["http://localhost"]}}
# GOOGLE_OAUTH_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/drive"]}

# ID de la carpeta raíz en Google Drive (PersonalDST-APP), donde la app crea
# las subcarpetas de grupos y empleados. Es el DESTINO de sync_structure.py.
# Copia el ID desde la URL de Drive: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id

# ID de la carpeta PERSONAL (estructura original de RRHH). Es el ORIGEN de
# sync_structure.py, del que se lee la estructura de carpetas. Solo lectura;
# el script nunca modifica nada dentro de esta carpeta.
GOOGLE_DRIVE_SOURCE_FOLDER_ID=your-source-folder-id
